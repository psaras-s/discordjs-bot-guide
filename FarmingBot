```typescript
import { CommandInteraction, SlashCommandBuilder, EmbedBuilder } from 'discord.js';

export const membersCommand = {
  data: new SlashCommandBuilder()
    .setName('memberscount')
    .setDescription('Display a list of all server members with count'),

  async execute(interaction: CommandInteraction) {
    if (!interaction.guild) {
      await interaction.reply({ content: 'This command can only be used in a server!', ephemeral: true });
      return;
    }

    try {
      // Fetch all members to ensure we have the complete list
      await interaction.guild.members.fetch();
      
      const members = interaction.guild.members.cache;
      const memberCount = members.size;

      // Separate bots and humans
      const humans = members.filter(member => !member.user.bot);
      const bots = members.filter(member => member.user.bot);

      // Create member lists with status indicators
      const createMemberList = (memberCollection: any, isBot = false) => {
        const memberArray = Array.from(memberCollection.values());
        
        if (memberArray.length === 0) {
          return isBot ? 'No bots found' : 'No members found';
        }

        // Sort by status (online first) and then by username
        memberArray.sort((a, b) => {
          const statusOrder = { 'online': 1, 'idle': 2, 'dnd': 3, 'offline': 4 };
          const aStatus = statusOrder[a.presence?.status || 'offline'] || 4;
          const bStatus = statusOrder[b.presence?.status || 'offline'] || 4;
          
          if (aStatus !== bStatus) return aStatus - bStatus;
          return a.user.username.localeCompare(b.user.username);
        });

        return memberArray.map(member => {
          const statusEmoji = {
            'online': '🟢',
            'idle': '🟡', 
            'dnd': '🔴',
            'offline': '⚫'
          };
          
          const status = member.presence?.status || 'offline';
          const emoji = statusEmoji[status] || '⚫';
          
          return `${emoji} ${member.user.username}`;
        }).join('\n');
      };

      // Create embeds for the member list
      const humanList = createMemberList(humans);
      const botList = createMemberList(bots, true);

      const embed = new EmbedBuilder()
        .setColor('#00FF7F')
        .setTitle(`🌾 ${interaction.guild.name} Member List 🌾`)
        .setDescription(`Total Members: **${memberCount}** (${humans.size} humans, ${bots.size} bots)`)
        .setTimestamp()
        .setFooter({ 
          text: `Requested by ${interaction.user.username}`, 
          iconURL: interaction.user.displayAvatarURL() 
        });

      // Add human members field (split if too long)
      if (humanList.length <= 1024) {
        embed.addFields({
          name: `👥 Human Members (${humans.size})`,
          value: humanList || 'No human members found',
          inline: false
        });
      } else {
        // Split long member list into multiple fields
        const chunks = humanList.match(/.{1,1020}/g) || [];
        chunks.forEach((chunk, index) => {
          embed.addFields({
            name: `👥 Human Members ${index + 1}/${chunks.length}`,
            value: chunk,
            inline: false
          });
        });
      }

      // Add bot members field (if there are any)
      if (bots.size > 0) {
        if (botList.length <= 1024) {
          embed.addFields({
            name: `🤖 Bots (${bots.size})`,
            value: botList,
            inline: false
          });
        } else {
          // Split long bot list if needed
          const chunks = botList.match(/.{1,1020}/g) || [];
          chunks.forEach((chunk, index) => {
            embed.addFields({
              name: `🤖 Bots ${index + 1}/${chunks.length}`,
              value: chunk,
              inline: false
            });
          });
        }
      }

      // Add legend
      embed.addFields({
        name: '📊 Status Legend',
        value: '🟢 Online • 🟡 Idle • 🔴 Do Not Disturb • ⚫ Offline',
        inline: false
      });

      await interaction.reply({ embeds: [embed] });

    } catch (error) {
      console.error('Error in memberscount command:', error);
      
      await interaction.reply({ 
        content: 'Sorry, there was an error fetching the member list. Please try again later.', 
        ephemeral: true 
      });
    }
  },
};
```

### server/bot/events/guildMemberAdd.ts
```typescript
import { GuildMember, EmbedBuilder, TextChannel } from 'discord.js';

export async function handleGuildMemberAdd(member: GuildMember) {
  try {
    console.log(`New member joined: ${member.user.tag}`);
    
    // Find a welcome channel (look for common names)
    const welcomeChannelNames = ['welcome', 'general', 'main', 'lobby', 'entrance'];
    let welcomeChannel: TextChannel | null = null;
    
    for (const channelName of welcomeChannelNames) {
      const channel = member.guild.channels.cache.find(
        ch => ch.name.toLowerCase().includes(channelName) && ch.isTextBased()
      ) as TextChannel;
      
      if (channel) {
        welcomeChannel = channel;
        break;
      }
    }
    
    // If no welcome channel found, use the first available text channel
    if (!welcomeChannel) {
      const textChannels = member.guild.channels.cache.filter(
        ch => ch.isTextBased() && ch.type === 0
      );
      welcomeChannel = textChannels.first() as TextChannel;
    }
    
    if (welcomeChannel) {
      // Create welcome embed
      const welcomeEmbed = new EmbedBuilder()
        .setColor('#00FF7F')
        .setTitle('🌾 Welcome to the Farm! 🌾')
        .setDescription(`Welcome ${member.user}, we're excited to have you join our farming community!`)
        .addFields(
          { 
            name: '🚜 Getting Started', 
            value: 'Use `/help` to see all available commands and start your farming journey!' 
          },
          { 
            name: '📊 Bot Commands', 
            value: 'Type `/commands` to see the full list of bot features available to you.' 
          },
          { 
            name: '🎮 Have Fun!', 
            value: 'Enjoy your time in the server and happy farming!' 
          }
        )
        .setThumbnail(member.user.displayAvatarURL())
        .setTimestamp()
        .setFooter({ 
          text: `Member #${member.guild.memberCount}`, 
          iconURL: member.guild.iconURL() || undefined 
        });

      // Send welcome message
      await welcomeChannel.send({ 
        content: `${member.user} just joined the server! 🎉`, 
        embeds: [welcomeEmbed] 
      });
      
      console.log(`Welcome message sent to ${welcomeChannel.name} for ${member.user.tag}`);
    } else {
      console.log(`No suitable welcome channel found for ${member.user.tag}`);
    }
    
  } catch (error) {
    console.error('Error in welcome handler:', error);
  }
}
```

