```typescript
import { CommandInteraction, SlashCommandBuilder, EmbedBuilder, PermissionFlagsBits } from 'discord.js';

export const restartCommand = {
  data: new SlashCommandBuilder()
    .setName('restart')
    .setDescription('Restart the bot (administrator only)')
    .setDefaultMemberPermissions(PermissionFlagsBits.Administrator),

  async execute(interaction: CommandInteraction) {
    // Check if user has administrator permissions
    if (!interaction.memberPermissions?.has(PermissionFlagsBits.Administrator)) {
      const noPermEmbed = new EmbedBuilder()
        .setColor('#FF0000')
        .setTitle('❌ Access Denied')
        .setDescription('You need **Administrator** permissions to restart the bot.')
        .setFooter({ text: 'Contact a server administrator for help' })
        .setTimestamp();

      await interaction.reply({ embeds: [noPermEmbed], ephemeral: true });
      return;
    }

    // Create restart confirmation embed
    const restartEmbed = new EmbedBuilder()
      .setColor('#FFA500')
      .setTitle('🔄 Bot Restarting')
      .setDescription('The bot is restarting... It will be back online in a few seconds.')
      .addFields(
        {
          name: '⏱️ Estimated Downtime',
          value: '3-5 seconds',
          inline: true
        },
        {
          name: '🔄 Bot will automatically reconnect',
          value: 'Today at ' + new Date().toLocaleTimeString(),
          inline: true
        }
      )
      .setFooter({ text: `Restart initiated by ${interaction.user.username}` })
      .setTimestamp();

    try {
      // Send restart message
      await interaction.reply({ embeds: [restartEmbed] });
      
      console.log(`Bot restart initiated by ${interaction.user.tag} in ${interaction.guild?.name || 'DM'}`);
      
      // Wait a moment for the message to be sent
      setTimeout(() => {
        console.log('Bot restarting via /restart command...');
        process.exit(0); // Exit cleanly - hosting platform will restart automatically
      }, 2000);
      
    } catch (error) {
      console.error('Error during restart command:', error);
      
      const errorEmbed = new EmbedBuilder()
        .setColor('#FF0000')
        .setTitle('❌ Restart Failed')
        .setDescription('There was an error attempting to restart the bot. Please try again or contact support.')
        .setTimestamp();
      
      if (interaction.replied) {
        await interaction.followUp({ embeds: [errorEmbed], ephemeral: true });
      } else {
        await interaction.reply({ embeds: [errorEmbed], ephemeral: true });
      }
    }
  },
};
```

